# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?

# Xcode — o .xcodeproj é gerado pelo XcodeGen a partir do project.yml, que é a
# forma versionada da configuração: o arquivo gerado tem ordenação instável,
# conflita com frequência e não é revisável em diff.
*.xcodeproj
*.xcworkspace

# Xcode
build/
DerivedData/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Assinatura e distribuição
*.mobileprovision
*.provisionprofile
*.p12
*.cer
ExportOptions.plist

# Segredos — nunca versionar credencial
.env
.env.*
!.env.example
secrets/

# Claude Code (configuração local, não versionada)
.claude/
CLAUDE.md

# Processo e especificações — locais por ora, fora do GitHub
docs/
specs/
